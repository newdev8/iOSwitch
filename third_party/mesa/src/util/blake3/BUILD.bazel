# Mesa's src/util/blake3/meson.build, in Bazel: what NVK's build needs of it (third_party/mesa/bazel/defs.bzl).
# Translated from the compile, archive and generator commands of the meson builds that reproduce main's NVK dylibs.

load("//bazel/lint:defs.bzl", "lint_files")
load("//third_party/mesa/bazel:defs.bzl", "MESA_LINT_EXCLUDE", "mesa_args", "mesa_cc_library")
load("//third_party/mesa/bazel:identity.bzl", "mesa_identity_files")

package(default_visibility = ["//visibility:public"])

lint_files(
    dirs = [],
    exclude = MESA_LINT_EXCLUDE,
)

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

mesa_identity_files()

# Every header of this package, its generated ones included: //third_party/mesa:headers gathers them.
filegroup(
    name = "headers",
    srcs = glob(
        ["**/*.h"],
        allow_empty = True,
    ),
)

mesa_cc_library(
    name = "blake3",
    c_args = mesa_args(
        "c",
        extra = {
            "ios": ["-Wno-error"],
            # The vendored tree has no x86-64 .S variants; the portable path serves the mock harness (the defines
            # are unread anywhere else: they only gate IS_X86 code).
            "macos": [
                "-Wno-error",
                "-DBLAKE3_NO_SSE2",
                "-DBLAKE3_NO_SSE41",
                "-DBLAKE3_NO_AVX2",
                "-DBLAKE3_NO_AVX512",
            ],
        },
        include_dirs = [
            "gen:src/util/blake3",
            "src/util/blake3",
        ],
    ),
    sources = [
        "blake3.c",
        "blake3_dispatch.c",
        "blake3_portable.c",
    ] + select({
        "@platforms//cpu:aarch64": ["blake3_neon.c"],
        "//conditions:default": [],
    }),
)
